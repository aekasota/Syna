<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Syna.Core\Syna.Core.csproj" />
  </ItemGroup>

  <!-- Interop tests load the real engine, built by scripts/build.ps1 in the same configuration. -->
  <PropertyGroup>
    <NativeBinDir>$(MSBuildThisFileDirectory)..\..\build\native-$(Configuration)\bin\</NativeBinDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NativeBinDir)*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
