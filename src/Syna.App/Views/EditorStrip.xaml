<UserControl
    x:Class="Syna.Views.EditorStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Syna.Controls"
    xmlns:v="using:Syna.Views"
    xmlns:vm="using:Syna.ViewModels">

    <Grid x:Name="Root" Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Docked" />
                <VisualState x:Name="Overlay">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{StaticResource FullscreenBarBrush}" />
                        <Setter Target="Root.BorderThickness" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- Time -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,6,12,0" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" Style="{StaticResource TimecodeText}" AutomationProperties.Name="Position" />
            <TextBlock Text="/" FontSize="13" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" Style="{StaticResource TimecodeText}" FontSize="13" FontWeight="Normal"
                       Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.Name="Duration" />
        </StackPanel>
        <c:TimelineView x:Name="Timeline" Grid.Column="1" Margin="0,6,16,0" AutomationProperties.Name="Timeline" />

        <!-- Audio lanes -->
        <ItemsControl x:Name="Lanes" Grid.Row="1" Grid.ColumnSpan="2" Visibility="{x:Bind ViewModel.AudioPanelVisible, Mode=OneWay}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AudioTrackViewModel">
                    <Grid Height="54" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="212" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Padding="0,7,10,7" Background="Transparent" ContextRequested="OnLaneContextRequested">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{x:Bind Color, Mode=OneWay}" RadiusX="1.5" RadiusY="1.5" Margin="0,1" />
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource BodyText}" FontSize="12" FontWeight="Medium"
                                           ToolTipService.ToolTip="{x:Bind Detail}" DoubleTapped="OnLabelDoubleTapped" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="2" StepFrequency="0.01" Value="{x:Bind Gain, Mode=TwoWay}" IsThumbToolTipEnabled="False"
                                            Margin="0,-6,0,-6" DoubleTapped="OnGainDoubleTapped" AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                                            ToolTipService.ToolTip="Volume (double-click resets to the default)" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GainText, Mode=OneWay}" Style="{StaticResource CaptionText}"
                                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="0,1,10,0">
                                <ToggleButton Style="{StaticResource TrackToggle}" Content="M" Tag="{ThemeResource ErrorBrush}" IsChecked="{x:Bind Muted, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute" />
                                <ToggleButton Style="{StaticResource TrackToggle}" Content="S" Tag="{ThemeResource AccentBrush}" IsChecked="{x:Bind Soloed, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Solo" AutomationProperties.Name="Solo" />
                            </StackPanel>
                            <Grid Grid.Column="3" Width="4" CornerRadius="2" Background="{ThemeResource MeterTrackBrush}" AutomationProperties.AccessibilityView="Raw">
                                <Rectangle Fill="{x:Bind Color, Mode=OneWay}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="{x:Bind Level, Mode=OneWay}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1" Margin="0,4,16,4" CornerRadius="{StaticResource RadiusSmall}" Background="{ThemeResource LaneBrush}"
                              PointerPressed="OnLanePointerPressed" PointerMoved="OnLanePointerMoved" PointerReleased="OnLanePointerReleased">
                            <c:WaveformView Loaded="OnWaveformLoaded" Unloaded="OnWaveformUnloaded" />
                            <Border Visibility="{x:Bind HasOffset, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                    Padding="6,1" CornerRadius="{StaticResource RadiusSmall}" Background="{ThemeResource Surface3Brush}" IsHitTestVisible="False">
                                <TextBlock Text="{x:Bind OffsetText, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Canvas x:Name="LaneOverlay" Grid.Row="1" Grid.Column="1" Margin="0,0,16,0" IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.AudioPanelVisible, Mode=OneWay}">
            <Rectangle x:Name="LanePlayhead" Width="1" Fill="{ThemeResource PlayheadBrush}" Opacity="0.8" />
        </Canvas>

        <!-- Transport -->
        <Grid x:Name="Transport" Grid.Row="2" Grid.ColumnSpan="2" Padding="10,0,16,0" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="InButton" Style="{StaticResource QuietButton}" Click="OnInClick" Padding="8,0" ToolTipService.ToolTip="Set IN (I) · Go to IN (Shift+I)" AutomationProperties.Name="Set IN">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="MarkIn" />
                        <TextBlock x:Name="InText" Text="IN" FontSize="12" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="OutButton" Style="{StaticResource QuietButton}" Click="OnOutClick" Padding="8,0" ToolTipService.ToolTip="Set OUT (O) · Go to OUT (Shift+O)" AutomationProperties.Name="Set OUT">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="OutText" Text="OUT" FontSize="12" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        <c:Icon Kind="MarkOut" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClearRangeButton" Style="{StaticResource IconButton}" Click="OnClearRangeClick" Visibility="Collapsed"
                        ToolTipService.ToolTip="Clear selection (Ctrl+Shift+X)" AutomationProperties.Name="Clear selection">
                    <c:Icon Kind="Close" Width="14" Height="14" />
                </Button>
                <Rectangle Width="1" Height="18" Fill="{ThemeResource BorderStrongBrush}" Margin="6,0" />
                <ToggleButton Style="{StaticResource ToggleIconButton}" IsChecked="{x:Bind ViewModel.LoopEnabled, Mode=TwoWay}"
                              ToolTipService.ToolTip="Loop selection (R)" AutomationProperties.Name="Loop">
                    <c:Icon Kind="Loop" />
                </ToggleButton>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButton}" Click="OnFrameBackClick" ToolTipService.ToolTip="Previous frame (←)" AutomationProperties.Name="Previous frame">
                    <c:Icon Kind="FrameBack" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource TransportButton}" Click="OnSkipBackClick" ToolTipService.ToolTip="Back 1 s (Shift+←) · 5 s (Ctrl+←)" AutomationProperties.Name="Skip back">
                    <c:Icon Kind="SkipBack" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource PlayButton}" Click="OnPlayClick" Margin="6,0" ToolTipService.ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause">
                    <c:Icon Kind="{x:Bind v:Ui.PlayIcon(ViewModel.IsPlaying), Mode=OneWay}" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource TransportButton}" Click="OnSkipForwardClick" ToolTipService.ToolTip="Forward 1 s (Shift+→) · 5 s (Ctrl+→)" AutomationProperties.Name="Skip forward">
                    <c:Icon Kind="SkipForward" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource TransportButton}" Click="OnFrameForwardClick" ToolTipService.ToolTip="Next frame (→)" AutomationProperties.Name="Next frame">
                    <c:Icon Kind="FrameForward" Width="18" Height="18" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="RateButton" Style="{StaticResource QuietButton}" Padding="8,0" MinWidth="46" ToolTipService.ToolTip="Playback speed ([ and ])"
                        AutomationProperties.Name="Playback speed">
                    <TextBlock Text="{x:Bind ViewModel.RateText, Mode=OneWay}" FontSize="12" Typography.NumeralAlignment="Tabular" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="RateMenu" Opening="OnRateMenuOpening" Placement="Top" />
                    </Button.Flyout>
                </Button>
                <ToggleButton Style="{StaticResource ToggleIconButton}" IsChecked="{x:Bind ViewModel.MasterMuted, Mode=TwoWay}"
                              ToolTipService.ToolTip="Mute all (M)" AutomationProperties.Name="Mute all">
                    <c:Icon Kind="{x:Bind v:Ui.VolumeIcon(ViewModel.MasterMuted, ViewModel.MasterVolume), Mode=OneWay}" />
                </ToggleButton>
                <Slider Width="92" Minimum="0" Maximum="1.5" StepFrequency="0.01" Value="{x:Bind ViewModel.MasterVolume, Mode=TwoWay}" IsThumbToolTipEnabled="False"
                        VerticalAlignment="Center" Margin="2,0,10,0" AutomationProperties.Name="Volume" ToolTipService.ToolTip="Volume (↑ ↓)" />
                <Button Style="{StaticResource IconButton}" Click="OnSaveFrameClick" ToolTipService.ToolTip="Save frame as PNG (Ctrl+Shift+S)" AutomationProperties.Name="Save frame">
                    <c:Icon Kind="Camera" />
                </Button>
                <Button x:Name="TrimButton" Style="{StaticResource QuietButton}" Click="OnTrimClick" Padding="10,0" ToolTipService.ToolTip="Trim selection (Ctrl+T)" AutomationProperties.Name="Trim">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="Trim" />
                        <TextBlock Text="Trim" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnFullscreenClick" ToolTipService.ToolTip="Fullscreen (F)" AutomationProperties.Name="Fullscreen">
                    <c:Icon Kind="Fullscreen" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
