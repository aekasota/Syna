<UserControl
    x:Class="Syna.Views.ExplorerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Syna.Controls"
    xmlns:v="using:Syna.Views"
    xmlns:vm="using:Syna.ViewModels">

    <Grid Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Source switch -->
        <Grid Padding="10,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="{ThemeResource Surface2Brush}" CornerRadius="{StaticResource RadiusMedium}" Padding="2"
                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                <RadioButton x:Name="FolderMode" Style="{StaticResource SegmentButton}" Content="Folder" GroupName="explorer" Checked="OnModeChecked" />
                <RadioButton x:Name="RecentMode" Style="{StaticResource SegmentButton}" Content="Recent" GroupName="explorer" Checked="OnModeChecked" />
                <RadioButton x:Name="StarredMode" Style="{StaticResource SegmentButton}" Content="Starred" GroupName="explorer" Checked="OnModeChecked" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnOpenFolderClick"
                    ToolTipService.ToolTip="Open folder (Ctrl+Shift+O)" AutomationProperties.Name="Open folder">
                <c:Icon Kind="Folder" />
            </Button>
        </Grid>

        <!-- Navigation -->
        <Grid Grid.Row="1" Padding="6,0,10,6" ColumnSpacing="2" Visibility="{x:Bind ViewModel.Explorer.IsFolderMode, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBackClick" IsEnabled="{x:Bind ViewModel.Explorer.CanGoBack, Mode=OneWay}"
                    ToolTipService.ToolTip="Back (Alt+←)" AutomationProperties.Name="Back">
                <c:Icon Kind="ChevronLeft" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnForwardClick" IsEnabled="{x:Bind ViewModel.Explorer.CanGoForward, Mode=OneWay}"
                    ToolTipService.ToolTip="Forward (Alt+→)" AutomationProperties.Name="Forward">
                <c:Icon Kind="ChevronRight" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnUpClick" IsEnabled="{x:Bind ViewModel.Explorer.CanGoUp, Mode=OneWay}"
                    ToolTipService.ToolTip="Up one level (Alt+↑)" AutomationProperties.Name="Up">
                <c:Icon Kind="ArrowUp" />
            </Button>
            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.Explorer.Title, Mode=OneWay}" Style="{StaticResource BodyText}" FontWeight="Medium"
                       VerticalAlignment="Center" Margin="8,0,0,0" ToolTipService.ToolTip="{x:Bind ViewModel.Explorer.CurrentFolder, Mode=OneWay}" />
        </Grid>

        <!-- Filter -->
        <TextBox x:Name="FilterBox" Grid.Row="2" Style="{StaticResource FieldTextBox}" Margin="10,0,10,8" PlaceholderText="Filter by name"
                 Text="{x:Bind ViewModel.Explorer.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter files" />

        <ListView x:Name="Items" Grid.Row="3" ItemsSource="{x:Bind ViewModel.Explorer.Items, Mode=OneWay}" SelectionMode="Extended" IsItemClickEnabled="False"
                  CanDragItems="True" DragItemsStarting="OnDragItemsStarting" DoubleTapped="OnItemsDoubleTapped" KeyDown="OnItemsKeyDown"
                  Padding="4,0,4,8" AutomationProperties.Name="Files">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExplorerItem">
                    <Grid ColumnSpacing="10" Background="Transparent" ContextRequested="OnItemContextRequested" ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:Icon Kind="Folder" Visibility="{x:Bind IsFolder}" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <c:Icon Kind="VideoFile" Visibility="{x:Bind IsMedia}" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" FontSize="12.5" />
                            <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource CaptionText}" Visibility="{x:Bind v:Ui.ShowText(Meta), Mode=OneWay}"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentBrush}" Visibility="{x:Bind IsNew, Mode=OneWay}" ToolTipService.ToolTip="New in a watched folder" />
                            <c:Icon Kind="StarFilled" Width="12" Height="12" Foreground="{ThemeResource AccentBrush}" Visibility="{x:Bind IsFavorite, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Explorer.Message, Mode=OneWay}" Visibility="{x:Bind ViewModel.Explorer.HasMessage, Mode=OneWay}"
                   Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="16,12" VerticalAlignment="Top" />
        <ProgressBar Grid.Row="3" IsIndeterminate="True" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.Explorer.IsLoading, Mode=OneWay}" />
    </Grid>
</UserControl>
