<UserControl
    x:Class="Syna.Views.InfoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Syna.Controls">

    <Border Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="16,10,8,10" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Media info" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" />
                <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="OnCopyClick"
                        AutomationProperties.Name="Copy media info" ToolTipService.ToolTip="Copy as text">
                    <c:Icon Kind="Copy" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnCloseClick"
                        AutomationProperties.Name="Close media info" ToolTipService.ToolTip="Close">
                    <c:Icon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
                <StackPanel x:Name="Sections" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Open a clip to see its details." Style="{StaticResource SmallText}" Margin="16,4,16,0" />
        </Grid>
    </Border>
</UserControl>
