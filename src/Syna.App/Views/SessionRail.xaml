<UserControl
    x:Class="Syna.Views.SessionRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Syna.Controls"
    xmlns:v="using:Syna.Views"
    xmlns:vm="using:Syna.ViewModels">

    <Grid Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="16,0,8,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="OPEN CLIPS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,4,0" Typography.NumeralAlignment="Tabular" />
            <Button x:Name="CloseAllButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="OnCloseAllClick" Visibility="Collapsed"
                    ToolTipService.ToolTip="Close all clips" AutomationProperties.Name="Close all clips">
                <c:Icon Kind="CloseAll" Width="15" Height="15" />
            </Button>
        </Grid>

        <ListView x:Name="List" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sessions}" SelectionMode="Single" CanReorderItems="True" AllowDrop="True"
                  CanDragItems="True" Padding="6,0,6,12" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Open clips">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionViewModel">
                    <Grid RowSpacing="6" Background="Transparent" PointerEntered="OnItemPointerEntered" PointerExited="OnItemPointerExited"
                          PointerPressed="OnItemPointerPressed" ContextRequested="OnItemContextRequested" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid CornerRadius="{StaticResource RadiusSmall}" Background="{ThemeResource StageBrush}" Height="100">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" Opacity="{x:Bind v:Ui.Opacity(IsMissing), Mode=OneWay}" />
                            <c:Icon Kind="VideoFile" Width="22" Height="22" Foreground="#4A4D53" Visibility="{x:Bind v:Ui.Hide(IsMissing), Mode=OneWay}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.ZIndex="-1" />
                            <Border Visibility="{x:Bind IsMissing, Mode=OneWay}" Background="#B3000000" CornerRadius="3" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Missing file" FontSize="11" Foreground="#F2C46B" />
                            </Border>
                            <Border Background="#C7000000" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                    Visibility="{x:Bind v:Ui.ShowText(DurationText), Mode=OneWay}">
                                <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" FontSize="11" Foreground="White" Typography.NumeralAlignment="Tabular" />
                            </Border>
                            <c:Icon Kind="StarFilled" Width="14" Height="14" Foreground="{ThemeResource AccentBrush}" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{x:Bind IsFavorite, Mode=OneWay}" />
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="24" Height="24" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#B3000000" Foreground="White" Opacity="0" Click="OnCloseClick" ToolTipService.ToolTip="Close (middle-click)"
                                    AutomationProperties.Name="Close clip">
                                <c:Icon Kind="Close" Width="12" Height="12" />
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind FileName, Mode=OneWay}" Style="{StaticResource SmallText}" Foreground="{ThemeResource TextPrimaryBrush}" Margin="2,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyHint" Grid.Row="1" Spacing="6" Margin="16,8,16,0" Visibility="Collapsed">
            <TextBlock Text="No clips open." Style="{StaticResource SmallText}" />
            <TextBlock Text="Opened clips stay here so you can switch between them." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
