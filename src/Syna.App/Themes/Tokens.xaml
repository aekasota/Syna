            <Color x:Key="WarningColor">#E6C25A</Color>
            <Color x:Key="ErrorColor">#EF6B67</Color>
            <Color x:Key="InfoColor">#7DB3E8</Color>
            <Color x:Key="Track1Color">#8FB2DE</Color>
