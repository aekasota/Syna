<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens. Every color, size and duration used by the app comes from here.
        Dark is the primary theme; light is designed separately (not an inversion). The video stage
        stays dark in both themes so the picture is never surrounded by bright chrome.
    -->
