    <!-- Fullscreen controls float over video, so they stay dark in both themes. -->
    <SolidColorBrush x:Key="FullscreenBarBrush" Color="#E6101113" />


    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <x:Double x:Key="TextCaption">11</x:Double>
    <x:Double x:Key="TextSmall">12</x:Double>
    <x:Double x:Key="TextBody">13</x:Double>
    <x:Double x:Key="TextSubtitle">14</x:Double>
    <x:Double x:Key="TextTitle">18</x:Double>
    <x:Double x:Key="TextTimecode">15</x:Double>

    <!-- Geometry -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
